<script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Hero Map Pins Interactive Inspection
      const pins = document.querySelectorAll('.hero-pin');
      const cardTicketId = document.getElementById('card-ticket-id');
      const cardTitle = document.getElementById('card-title');
      const cardWard = document.getElementById('card-ward');
      const cardDept = document.getElementById('card-dept');
      const cardOfficer = document.getElementById('card-officer');
      const cardSla = document.getElementById('card-sla');
      const cardTime = document.getElementById('card-time');
      const cardStatus = document.getElementById('card-status-badge');

      pins.forEach(pin => {
        pin.addEventListener('click', () => {
          cardTicketId.textContent = '#' + pin.dataset.id;
          cardTitle.textContent = pin.dataset.title;
          cardWard.textContent = pin.dataset.ward;
          cardDept.textContent = pin.dataset.dept;
          cardOfficer.textContent = pin.dataset.officer;
          cardSla.innerHTML = `<span class="material-symbols-outlined text-[14px]">timer</span> ` + pin.dataset.sla;
          cardTime.textContent = pin.dataset.time;
          cardStatus.textContent = pin.dataset.status;
          
          // Visual pulse feedback
          pins.forEach(p => p.classList.remove('scale-125'));
          pin.classList.add('scale-125');
        });
      });

      // 2. Hero Filter Buttons
      const filterBtns = document.querySelectorAll('.hero-filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-primary', 'text-on-primary', 'active');
            b.classList.add('text-secondary');
          });
          btn.classList.add('bg-primary', 'text-on-primary', 'active');
          btn.classList.remove('text-secondary');

          const category = btn.dataset.category;
          pins.forEach(pin => {
            if (category === 'all' || pin.dataset.category === category) {
              pin.style.display = 'block';
            } else {
              pin.style.display = 'none';
            }
          });
        });
      });

      // 3. Service Bar Expandable Pill Drawer logic on click
      const pillItems = document.querySelectorAll('.service-pill-item');
      pillItems.forEach(item => {
        item.addEventListener('click', () => {
          const drawer = item.querySelector('.pill-drawer');
          const icon = item.querySelector('.pill-toggle-icon');
          if (drawer.style.maxHeight && drawer.style.maxHeight !== '0px') {
            drawer.style.maxHeight = '0px';
            icon.textContent = 'add';
          } else {
            drawer.style.maxHeight = '120px';
            icon.textContent = 'remove';
          }
        });
      });

      // 4. Live City Ward Selector
      const wardData = {
        'w01': {
          code: 'WARD-01-CORE',
          name: 'Central Business & Civic Spine',
          desc: 'Covers main commercial avenues, the supreme judicial plaza, and transit terminus. High footfall zone.',
          stress: '28% (Low)',
          stressBar: '28%',
          status: 'Optimal Flow',
          statusClass: 'bg-emerald-100 text-emerald-800',
          active: '19',
          inspectors: '12',
          sla: '97.4%',
          tickets: [
            { icon: 'traffic', title: 'Pedestrian Crossing Button Desync', sub: 'Market St. & 4th // SLA: 2h 10m', tag: 'Triage OK' },
            { icon: 'cleaning_services', title: 'Plaza Fountain Drainage Blockage', sub: 'Civic Esplanade // SLA: 4h 00m', tag: 'En Route' },
            { icon: 'water', title: 'Irrigation Line Slow Seep', sub: 'Parkway Median // SLA: 7h 45m', tag: 'Scheduled' }
          ]
        },
        'w04': {
          code: 'WARD-04-WEST',
          name: 'West Industrial & Corridor',
          desc: 'Heavy freight avenues, warehouse logistics clusters, and commuter arterial highways.',
          stress: '64% (Moderate)',
          stressBar: '64%',
          status: 'Heavy Traffic Pressure',
          statusClass: 'bg-amber-100 text-amber-800',
          active: '42',
          inspectors: '18',
          sla: '91.2%',
          tickets: [
            { icon: 'construction', title: 'Freight Lane Pavement Cavity', sub: 'Truck Route 10 // SLA: 1h 15m', tag: 'Breach Risk' },
            { icon: 'lightbulb', title: 'Highway Sodium Lamp Down', sub: 'Overpass 4B // SLA: 5h 20m', tag: 'En Route' },
            { icon: 'bolt', title: 'Substation Gate Sensor Fault', sub: 'Substation West // SLA: 3h 10m', tag: 'Assigned' }
          ]
        },
        'w07': {
          code: 'WARD-07-HIST',
          name: 'South Historic & Cultural Quarter',
          desc: 'Cobblestone streets, heritage architecture regulations, and dense residential courtyards.',
          stress: '38% (Low)',
          stressBar: '38%',
          status: 'Controlled',
          statusClass: 'bg-emerald-100 text-emerald-800',
          active: '14',
          inspectors: '9',
          sla: '98.0%',
          tickets: [
            { icon: 'park', title: 'Heritage Oak Branch Trimming', sub: 'Cathedral Courtyard // SLA: 8h 00m', tag: 'Scheduled' },
            { icon: 'water_drop', title: 'Stone Canal Seepage Test', sub: 'Lower Lock // SLA: 6h 30m', tag: 'Under Review' },
            { icon: 'signpost', title: 'Historic Plaque Replacement', sub: 'Old Guild Hall // SLA: 14h 00m', tag: 'Logged' }
          ]
        },
        'w09': {
          code: 'WARD-09-HARBOR',
          name: 'North Harbor & Maritime District',
          desc: 'Commercial docks, cold storage warehouses, coastal defense dikes, and freight rail terminals.',
          stress: '82% (High Surge)',
          stressBar: '82%',
          status: 'Storm Protocol Active',
          statusClass: 'bg-red-100 text-red-800',
          active: '58',
          inspectors: '22',
          sla: '88.6%',
          tickets: [
            { icon: 'flood', title: 'Dock 3 Seawall Scupper Overflow', sub: 'Pier Avenue // SLA: 0h 42m', tag: 'URGENT' },
            { icon: 'delete_sweep', title: 'Commercial Fish Market Waste Spill', sub: 'Fishermans Reach // SLA: 2h 00m', tag: 'Dispatched' },
            { icon: 'power', title: 'Crane Bay High-Tension Fault', sub: 'North Gantry // SLA: 1h 30m', tag: 'On-Site' }
          ]
        }
      };

      const wardBtns = document.querySelectorAll('.ward-tab-btn');
      wardBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          wardBtns.forEach(b => {
            b.classList.remove('bg-primary', 'text-on-primary');
            b.classList.add('bg-surface-container-lowest', 'text-secondary');
          });
          btn.classList.add('bg-primary', 'text-on-primary');
          btn.classList.remove('bg-surface-container-lowest', 'text-secondary');

          const w = wardData[btn.dataset.ward];
          if (!w) return;

          document.getElementById('ward-code-label').textContent = w.code;
          document.getElementById('ward-name-label').textContent = w.name;
          document.getElementById('ward-desc-label').textContent = w.desc;
          document.getElementById('ward-stress-value').textContent = w.stress;
          document.getElementById('ward-stress-bar').style.width = w.stressBar;
          document.getElementById('ward-active-val').textContent = w.active;
          document.getElementById('ward-inspectors-val').textContent = w.inspectors;
          document.getElementById('ward-sla-val').textContent = w.sla;

          const chip = document.getElementById('ward-status-chip');
          chip.textContent = w.status;
          chip.className = `px-2.5 py-0.5 rounded-full font-label-sm text-label-sm font-bold ${w.statusClass}`;

          // Update feed
          const feed = document.getElementById('ward-ticket-feed');
          feed.innerHTML = w.tickets.map(t => `
            <div class="p-3.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary">
                  <span class="material-symbols-outlined text-[16px]">${t.icon}</span>
                </div>
                <div>
                  <span class="block font-title-md text-title-md text-primary font-bold">${t.title}</span>
                  <span class="text-xs text-secondary">${t.sub}</span>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-surface-container-lowest font-label-sm text-label-sm text-primary font-semibold">${t.tag}</span>
            </div>
          `).join('');
        });
      });

      // 5. Escalation Simulator
      const simBtns = document.querySelectorAll('.sim-btn');
      const box1 = document.getElementById('tier-box-1');
      const box2 = document.getElementById('tier-box-2');
      const box3 = document.getElementById('tier-box-3');
      const stat1 = document.getElementById('tier-status-1');
      const stat2 = document.getElementById('tier-status-2');
      const stat3 = document.getElementById('tier-status-3');

      simBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          simBtns.forEach(b => {
            b.className = 'sim-btn px-4 py-1.5 rounded-full bg-white/10 text-white hover:bg-white/20 text-xs font-bold transition-all';
          });
          const lvl = btn.dataset.level;

          if (lvl === '1') {
            btn.className = 'sim-btn px-4 py-1.5 rounded-full bg-[#16A36A] text-white text-xs font-bold transition-all';
            box1.className = 'p-5 rounded-2xl bg-white/10 border-l-4 border-[#16A36A] transition-all duration-300';
            box2.className = 'p-5 rounded-2xl bg-white/5 opacity-60 border-l-4 border-transparent transition-all duration-300';
            box3.className = 'p-5 rounded-2xl bg-white/5 opacity-60 border-l-4 border-transparent transition-all duration-300';
            stat1.textContent = 'Active Assignment';
            stat1.className = 'text-xs font-bold text-[#16A36A]';
            stat2.textContent = 'Standby';
            stat3.textContent = 'Standby';
          } else if (lvl === '2') {
            btn.className = 'sim-btn px-4 py-1.5 rounded-full bg-amber-500 text-white text-xs font-bold transition-all';
            box1.className = 'p-5 rounded-2xl bg-white/5 opacity-60 border-l-4 border-transparent transition-all duration-300';
            box2.className = 'p-5 rounded-2xl bg-white/15 border-l-4 border-amber-500 transition-all duration-300';
            box3.className = 'p-5 rounded-2xl bg-white/5 opacity-60 border-l-4 border-transparent transition-all duration-300';
            stat1.textContent = 'Escalated Past Window';
            stat1.className = 'text-xs font-bold text-white/50';
            stat2.textContent = 'Urgent Chime Pushed (Supervisor)';
            stat2.className = 'text-xs font-bold text-amber-400';
            stat3.textContent = 'Standby';
          } else if (lvl === '3') {
            btn.className = 'sim-btn px-4 py-1.5 rounded-full bg-red-600 text-white text-xs font-bold transition-all';
            box1.className = 'p-5 rounded-2xl bg-white/5 opacity-60 border-l-4 border-transparent transition-all duration-300';
            box2.className = 'p-5 rounded-2xl bg-white/5 opacity-60 border-l-4 border-transparent transition-all duration-300';
            box3.className = 'p-5 rounded-2xl bg-white/20 border-l-4 border-red-500 transition-all duration-300';
            stat1.textContent = 'Overdue';
            stat2.textContent = 'Supervisor Breach Logged';
            stat3.textContent = 'CRITICAL // Commissioner Pinned';
            stat3.className = 'text-xs font-bold text-red-400';
          }
        });
      });

      // 6. Dept Reorganization Interactive Toggle
      const reorgBtn = document.getElementById('toggle-reorg-btn');
      let reorgToggled = false;
      if (reorgBtn) {
        reorgBtn.addEventListener('click', () => {
          reorgToggled = !reorgToggled;
          const destTag = document.getElementById('reorg-dest-tag');
          const destTitle = document.getElementById('reorg-dest-title');
          const count = document.getElementById('reorg-migrated-count');
          const hash = document.getElementById('reorg-hash');

          if (reorgToggled) {
            reorgBtn.textContent = 'Revert to Baseline View';
            destTag.textContent = 'Transferred Hierarchy (Live)';
            destTitle.textContent = 'Metropolitan Infrastructure & Works Council';
            count.textContent = '2,890 Historical Records Intact';
            hash.textContent = 'Block #WW-99481 Verifiable';
          } else {
            reorgBtn.textContent = 'Simulate Dept Restructure';
            destTag.textContent = 'Future Unified Bureau (2025)';
            destTitle.textContent = 'Department of Urban Mobility & Pavement';
            count.textContent = '1,420 of 1,420 Preserved';
            hash.textContent = 'SHA-256 Validated';
          }
        });
      }

    });
