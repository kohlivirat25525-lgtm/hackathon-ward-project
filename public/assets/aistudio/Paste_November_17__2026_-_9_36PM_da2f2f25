<script>
    (function initCivicWorkspace() {
      // Elements
      const btnViewMap = document.getElementById('btn-view-map');
      const btnViewList = document.getElementById('btn-view-list');
      const mapViewport = document.getElementById('map-viewport');
      const listViewport = document.getElementById('list-viewport');
      const detailDrawer = document.getElementById('issue-detail-drawer');
      const closeDetailBtn = document.getElementById('close-detail-btn');
      const toggleFilterBtn = document.getElementById('toggle-filter-sidebar');
      const closeFilterBtn = document.getElementById('close-filters-btn');
      const filterSidebar = document.getElementById('filter-sidebar');

      // Detail fields
      const detailTicketId = document.getElementById('detail-ticket-id');
      const detailCategory = document.getElementById('detail-category');
      const detailTitle = document.getElementById('detail-title');
      const detailWard = document.getElementById('detail-ward');
      const detailSla = document.getElementById('detail-sla');
      const detailAgency = document.getElementById('detail-agency');
      const detailSeverityBadge = document.getElementById('detail-severity-badge');

      // 1. Toggle Map vs List Views
      if (btnViewMap && btnViewList && mapViewport && listViewport) {
        btnViewMap.addEventListener('click', () => {
          mapViewport.classList.remove('hidden');
          listViewport.classList.add('hidden');
          btnViewMap.className = 'px-4 py-1.5 rounded-full bg-surface-container-lowest text-primary font-label-md text-label-md shadow-sm transition-all flex items-center gap-1.5';
          btnViewList.className = 'px-4 py-1.5 rounded-full text-secondary hover:text-primary font-label-md text-label-md transition-all flex items-center gap-1.5';
        });

        btnViewList.addEventListener('click', () => {
          listViewport.classList.remove('hidden');
          mapViewport.classList.add('hidden');
          btnViewList.className = 'px-4 py-1.5 rounded-full bg-surface-container-lowest text-primary font-label-md text-label-md shadow-sm transition-all flex items-center gap-1.5';
          btnViewMap.className = 'px-4 py-1.5 rounded-full text-secondary hover:text-primary font-label-md text-label-md transition-all flex items-center gap-1.5';
        });
      }

      // 2. Incident Marker Click Handler
      const pins = document.querySelectorAll('.map-pin');
      pins.forEach(pin => {
        pin.addEventListener('click', (e) => {
          e.stopPropagation();
          const d = pin.dataset;
          if (detailTicketId) detailTicketId.textContent = '#' + d.id;
          if (detailTitle) detailTitle.textContent = d.title;
          if (detailCategory) detailCategory.textContent = d.category;
          if (detailWard) detailWard.innerHTML = `<span class="material-symbols-outlined text-[15px]">location_on</span> ` + d.ward;
          if (detailSla) detailSla.textContent = d.sla;
          if (detailAgency) detailAgency.textContent = d.agency;
          if (detailSeverityBadge) {
            detailSeverityBadge.textContent = d.severity;
            if (d.severity === 'Critical') {
              detailSeverityBadge.className = 'px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 font-label-sm text-label-sm font-semibold';
            } else if (d.severity === 'High') {
              detailSeverityBadge.className = 'px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 font-label-sm text-label-sm font-semibold';
            } else {
              detailSeverityBadge.className = 'px-2.5 py-0.5 rounded-full bg-surface-container text-secondary font-label-sm text-label-sm font-semibold';
            }
          }
          if (detailDrawer) {
            detailDrawer.classList.remove('translate-x-[120%]', 'hidden');
          }
        });
      });

      // 3. Table Row Click Handler
      const tableRows = document.querySelectorAll('#incident-table-body tr');
      tableRows.forEach(row => {
        row.addEventListener('click', () => {
          const id = row.dataset.id;
          const matchingPin = document.querySelector(`.map-pin[data-id="${id}"]`);
          if (matchingPin) {
            // switch to map view
            if (btnViewMap) btnViewMap.click();
            matchingPin.click();
          }
        });
      });

      // 4. Detail Drawer Close
      if (closeDetailBtn && detailDrawer) {
        closeDetailBtn.addEventListener('click', () => {
          detailDrawer.classList.add('hidden');
        });
      }

      // 5. Mobile Filter Sidebar Toggle
      if (toggleFilterBtn && filterSidebar) {
        toggleFilterBtn.addEventListener('click', () => {
          filterSidebar.classList.toggle('hidden');
        });
      }
      if (closeFilterBtn && filterSidebar) {
        closeFilterBtn.addEventListener('click', () => {
          filterSidebar.classList.add('hidden');
        });
      }

      // 6. Category Chip Active State Toggle
      const categoryChips = document.querySelectorAll('.category-chip');
      categoryChips.forEach(chip => {
        chip.addEventListener('click', () => {
          categoryChips.forEach(c => {
            c.className = 'category-chip px-3.5 py-1.5 rounded-full bg-surface-container-lowest text-on-surface-variant hover:text-primary font-label-md text-label-md whitespace-nowrap shadow-sm';
          });
          chip.className = 'category-chip px-3.5 py-1.5 rounded-full bg-primary text-on-primary font-label-md text-label-md whitespace-nowrap shadow-sm';
        });
      });
    })();
