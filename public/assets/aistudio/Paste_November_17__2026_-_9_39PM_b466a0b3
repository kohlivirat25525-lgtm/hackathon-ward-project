        modalCard.classList.add('scale-95');
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      
      if (confirmBtn) {
        confirmBtn.addEventListener('click', () => {
          confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">sync</span> Transmitting...';
          setTimeout(() => {
            confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span> Transmitted!';
            setTimeout(() => {
              closeModal();
              confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">send</span> Transmit Immediate Dispatch';
