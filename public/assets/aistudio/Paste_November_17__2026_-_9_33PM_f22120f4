<script>
  // State Store
  const reportState = {
    currentStep: 1,
    category: 'Potholes',
    categoryDesc: 'Road surface cavities, asphalt collapse, rutting',
    agency: 'Public Works (Roads)',
    title: 'Deep pavement crater in eastbound transit corridor',
    description: 'Severe asphalt deterioration approximately 35cm deep located near the Highland pedestrian crosswalk. Poses serious hazard to cyclists and bus suspensions during morning rush.',
    severity: 'Medium',
    dateObserved: new Date().toISOString().split('T')[0],
    timeWindow: 'Afternoon (12:00 - 18:00)',
    address: '742 West Highland Ave, Ward 04',
    coordinates: '41.8827° N, 87.6233° W',
    ward: 'Ward 04 — Central Civic',
    alderperson: 'Elena Rostova (District 04)',
    privacy: 'public',
    photosCount: 2,
    ticketId: '#WW-8924'
  };

  // Lifecycle Initialization
  document.addEventListener('DOMContentLoaded', () => {
    // Set default date picker
    const dateInput = document.getElementById('date-observed');
    if (dateInput) {
      dateInput.value = reportState.dateObserved;
    }

    // Load initial form bindings
    const titleInput = document.getElementById('issue-title');
    if (titleInput) {
      titleInput.value = reportState.title;
      document.getElementById('title-count').textContent = reportState.title.length;
    }

    const descInput = document.getElementById('issue-desc');
    if (descInput) {
      descInput.value = reportState.description;
      document.getElementById('desc-count').textContent = reportState.description.length;
    }

    // Set active category card visually
    highlightCategoryCard(reportState.category);
  });

  // Step Navigation Engine
  function goToStep(stepNumber) {
    if (stepNumber < 1 || stepNumber > 5) return;

    // Hide all step views
    for (let i = 1; i <= 5; i++) {
      const view = document.getElementById(`step-view-${i}`);
      if (view) view.classList.add('hidden');
    }

    // Show target step
    const target = document.getElementById(`step-view-${stepNumber}`);
    if (target) target.classList.remove('hidden');

    reportState.currentStep = stepNumber;
    updateStepperUI(stepNumber);
    updateReviewContent();
    window.scrollTo({ top: 120, behavior: 'smooth' });
  }

  function updateStepperUI(activeStep) {
    for (let i = 1; i <= 5; i++) {
      const btn = document.getElementById(`step-nav-${i}`);
      const badge = document.getElementById(`step-badge-${i}`);
      const line = document.getElementById(`line-${i}`);

      if (!btn) continue;

      if (i < activeStep) {
        // Completed
        btn.className = 'step-nav-btn flex items-center gap-2 px-4 py-2 rounded-full transition-all bg-surface-container text-primary font-bold';
        badge.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span>';
        badge.className = 'w-5 h-5 rounded-full flex items-center justify-center text-label-sm font-label-sm bg-primary text-on-primary';
        if (line) line.className = 'h-0.5 flex-1 min-w-4 bg-primary transition-all';
      } else if (i === activeStep) {
        // Active
        btn.className = 'step-nav-btn flex items-center gap-2 px-4 py-2 rounded-full transition-all bg-primary text-on-primary';
        badge.textContent = i;
        badge.className = 'w-5 h-5 rounded-full flex items-center justify-center text-label-sm font-label-sm bg-surface-container-lowest text-primary';
        if (line) line.className = 'h-0.5 flex-1 min-w-4 bg-surface-container-high transition-all';
      } else {
        // Future
        btn.className = 'step-nav-btn flex items-center gap-2 px-4 py-2 rounded-full transition-all text-on-surface-variant hover:bg-surface-container-low';
        badge.textContent = i;
        badge.className = 'w-5 h-5 rounded-full flex items-center justify-center text-label-sm font-label-sm bg-surface-container text-on-surface';
        if (line) line.className = 'h-0.5 flex-1 min-w-4 bg-surface-container-high transition-all';
      }
    }
  }

  // Step 1: Category Selection
  function selectCategory(catName, desc, iconName, agency) {
    reportState.category = catName;
    reportState.categoryDesc = desc;
    reportState.agency = agency;

    highlightCategoryCard(catName);

    const notice = document.getElementById('cat-selection-notice');
    if (notice) {
      notice.innerHTML = `<span class="text-primary font-semibold">Selected:</span> ${catName} — Allocated to <em>${agency}</em>`;
    }

    const step2Pill = document.getElementById('step2-cat-name');
    if (step2Pill) step2Pill.textContent = catName;
  }

  function highlightCategoryCard(catName) {
    const cards = document.querySelectorAll('.cat-card');
    cards.forEach(card => {
      if (card.getAttribute('data-cat') === catName) {
        card.classList.add('ring-2', 'ring-primary', 'bg-surface-container-low');
        card.classList.remove('bg-surface-container-lowest');
      } else {
        card.classList.remove('ring-2', 'ring-primary', 'bg-surface-container-low');
        card.classList.add('bg-surface-container-lowest');
      }
    });
  }

  function validateStep1() {
    if (!reportState.category) {
      showToast('Please select an issue category', 'warning');
      return;
    }
    goToStep(2);
  }

  // Step 2: Form Input Handlers
  function handleTitleInput(el) {
    reportState.title = el.value;
    document.getElementById('title-count').textContent = el.value.length;
    if (el.value.trim().length >= 6) {
      document.getElementById('title-error').classList.add('hidden');
    }
  }

  function handleDescInput(el) {
    reportState.description = el.value;
    document.getElementById('desc-count').textContent = el.value.length;
    if (el.value.trim().length >= 20) {
      document.getElementById('desc-error').classList.add('hidden');
    }
  }

  function selectSeverity(level, hint, colorClass) {
    reportState.severity = level;
    const buttons = document.querySelectorAll('.sev-btn');
    buttons.forEach(btn => {
      if (btn.getAttribute('data-sev') === level) {
        btn.classList.add('bg-surface-container', 'ring-1', 'ring-primary/20');
        btn.classList.remove('bg-surface-container-low');
      } else {
        btn.classList.remove('bg-surface-container', 'ring-1', 'ring-primary/20');
        btn.classList.add('bg-surface-container-low');
      }
    });
  }

  function validateStep2() {
    const titleVal = document.getElementById('issue-title').value.trim();
    const descVal = document.getElementById('issue-desc').value.trim();
    const titleErr = document.getElementById('title-error');
    const descErr = document.getElementById('desc-error');

    let valid = true;
    if (titleVal.length < 6) {
      titleErr.classList.remove('hidden');
      valid = false;
    } else {
      titleErr.classList.add('hidden');
    }

    if (descVal.length < 20) {
      descErr.classList.remove('hidden');
      valid = false;
    } else {
      descErr.classList.add('hidden');
    }

    if (!valid) return;

    reportState.title = titleVal;
    reportState.description = descVal;
    reportState.dateObserved = document.getElementById('date-observed').value;
    reportState.timeWindow = document.getElementById('time-window').value;

    goToStep(3);
  }

  // Step 3: Photos Management
  function simulateFileUpload() {
    const fileInput = document.getElementById('file-input');
    if (fileInput) fileInput.click();
  }

  function handleFileSelection(event) {
    const files = event.target.files;
    if (!files || files.length === 0) return;

    const grid = document.getElementById('photo-preview-grid');
    for (let i = 0; i < files.length; i++) {
      if (reportState.photosCount >= 4) {
        showToast('Maximum 4 photos allowed', 'info');
        break;
      }
      const file = files[i];
      const newCard = document.createElement('div');
      newCard.className = 'photo-preview-card relative rounded-DEFAULT overflow-hidden group shadow-sm bg-surface-container-low';
      newCard.setAttribute('data-filename', file.name);
      newCard.innerHTML = `
        <div class="h-44 w-full bg-cover bg-center flex items-center justify-center bg-surface-container-highest">
          <span class="material-symbols-outlined text-[40px] text-primary">image</span>
        </div>
        <div class="p-3 bg-surface-container-lowest">
          <p class="font-label-md text-label-md text-primary truncate">${file.name}</p>
          <p class="font-label-sm text-label-sm text-on-surface-variant">${(file.size / (1024 * 1024)).toFixed(1)} MB • Uploaded</p>
        </div>
        <button type="button" onclick="removePhoto(this)" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-primary/80 hover:bg-error text-on-primary flex items-center justify-center transition-all opacity-80 group-hover:opacity-100">
          <span class="material-symbols-outlined text-[16px]">close</span>
        </button>
      `;
      grid.appendChild(newCard);
      reportState.photosCount++;
    }
    updatePhotoBadges();
  }

  function removePhoto(btn) {
    const card = btn.closest('.photo-preview-card');
    if (card) {
      card.remove();
      reportState.photosCount = Math.max(0, reportState.photosCount - 1);
      updatePhotoBadges();
    }
  }

  function clearAllPhotos() {
    const grid = document.getElementById('photo-preview-grid');
    if (grid) grid.innerHTML = '';
    reportState.photosCount = 0;
    updatePhotoBadges();
  }

  function updatePhotoBadges() {
    const counter = document.getElementById('photo-counter');
    const badge = document.getElementById('photo-count-badge');
    if (counter) counter.textContent = reportState.photosCount;
    if (badge) badge.textContent = `${reportState.photosCount} Attached`;
  }

  function validateStep3() {
    // Photos are optional but encouraged
    goToStep(4);
  }

  // Step 4: Map & Geolocation Simulation
  function handleMapClick(event) {
    const rect = event.currentTarget.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;

    const pin = document.getElementById('map-pin');
    if (pin) {
      pin.style.left = `${x}px`;
      pin.style.top = `${y}px`;
    }

    // Dynamic coordinates perturbation simulation
    const lat = (41.8827 + (Math.random() - 0.5) * 0.005).toFixed(4);
    const lng = (87.6233 + (Math.random() - 0.5) * 0.005).toFixed(4);
    reportState.coordinates = `${lat}° N, ${lng}° W`;

    document.getElementById('geo-coords').textContent = reportState.coordinates;
    showToast('GPS Coordinates updated for parcel', 'info');
  }

  function handleAddressChange(val) {
    reportState.address = val;
    const pinLabel = document.getElementById('pin-label');
    if (pinLabel) pinLabel.textContent = val.split(',')[0] || val;
  }

  function useCurrentLocation() {
    showToast('Triangulating device coordinates...', 'info');
    setTimeout(() => {
      reportState.address = '810 South Michigan Ave, Ward 04';
      reportState.coordinates = '41.8719° N, 87.6248° W';
      
      const addrInput = document.getElementById('address-input');
      if (addrInput) addrInput.value = reportState.address;
      
      const pinLabel = document.getElementById('pin-label');
      if (pinLabel) pinLabel.textContent = '810 S Michigan Ave';
      
      document.getElementById('geo-coords').textContent = reportState.coordinates;
      showToast('Accurate GPS lock established: ±1.8m', 'check_circle');
    }, 700);
  }

  function zoomMap(delta) {
    showToast(delta > 0 ? 'Zooming map in (+1 level)' : 'Zooming map out (-1 level)', 'zoom_in');
  }

  function recenterMap() {
    const pin = document.getElementById('map-pin');
    if (pin) {
      pin.style.left = '50%';
      pin.style.top = '50%';
    }
    showToast('Map recentered on anchor coordinates', 'center_focus_strong');
  }

  function validateStep4() {
    const addr = document.getElementById('address-input').value.trim();
    if (!addr) {
      showToast('Please provide an address or pin location', 'warning');
      return;
    }
    reportState.address = addr;
    goToStep(5);
  }

  // Step 5: Review Synthesis
  function updateReviewContent() {
    const catBadge = document.getElementById('review-cat-badge');
    if (catBadge) catBadge.textContent = reportState.category;

    const sevBadge = document.getElementById('review-sev-badge');
    if (sevBadge) sevBadge.textContent = `${reportState.severity} Severity`;

    const titleEl = document.getElementById('review-title');
    if (titleEl) titleEl.textContent = reportState.title;

    const descEl = document.getElementById('review-desc');
    if (descEl) descEl.textContent = reportState.description;

    const dateEl = document.getElementById('review-date');
    if (dateEl) dateEl.textContent = `${reportState.dateObserved} • ${reportState.timeWindow.split(' ')[0]}`;

    const agencyEl = document.getElementById('review-agency');
    if (agencyEl) agencyEl.textContent = reportState.agency;

    const addrEl = document.getElementById('review-address');
    if (addrEl) addrEl.textContent = reportState.address;

    const coordsEl = document.getElementById('review-coords');
    if (coordsEl) coordsEl.textContent = `${reportState.coordinates} (${reportState.ward})`;
  }

  // Final Submission Flow
  function executeSubmission() {
    const btn = document.getElementById('submit-report-btn');
    const btnText = document.getElementById('submit-btn-text');
    const btnIcon = document.getElementById('submit-btn-icon');
    const spinner = document.getElementById('submit-spinner');

    // UI Loading state
    btn.disabled = true;
    btnText.textContent = 'Allocating & Hashing...';
    btnIcon.classList.add('hidden');
    spinner.classList.remove('hidden');

    setTimeout(() => {
      // Generate randomized ticket ID
      const randomTicketNum = Math.floor(1000 + Math.random() * 9000);
      reportState.ticketId = `#WW-${randomTicketNum}`;

      // Populate Success Screen
      document.getElementById('ticket-id').textContent = reportState.ticketId;
      document.getElementById('ticket-agency').textContent = reportState.agency;
      document.getElementById('ticket-location').textContent = `${reportState.address.split(',')[0]} (${reportState.ward.split('—')[0].trim()})`;
      document.getElementById('ticket-timestamp').textContent = 'Recorded at ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // Transition to Success view
      document.getElementById('step-view-5').classList.add('hidden');
      document.getElementById('success-screen').classList.remove('hidden');

      // Scroll smoothly to top of success card
      window.scrollTo({ top: 180, behavior: 'smooth' });

      showToast('Report dispatched and recorded on public ledger', 'task_alt');
    }, 1200);
  }

  // Copy Ticket ID Handler
  function copyTicketId() {
    navigator.clipboard.writeText(reportState.ticketId).then(() => {
      const copyLabel = document.getElementById('copy-btn-label');
      copyLabel.textContent = 'Copied!';
      showToast(`Complaint ID ${reportState.ticketId} copied to clipboard!`, 'content_copy');
      setTimeout(() => {
        copyLabel.textContent = 'Copy ID';
      }, 2500);
    }).catch(() => {
      showToast(`ID: ${reportState.ticketId}`, 'info');
    });
  }

  // Reset Engine for subsequent filing
  function resetReportingForm() {
    reportState.category = 'Potholes';
    reportState.title = '';
    reportState.description = '';
    reportState.severity = 'Medium';
    reportState.photosCount = 0;

    const titleIn = document.getElementById('issue-title');
    if (titleIn) titleIn.value = '';

    const descIn = document.getElementById('issue-desc');
    if (descIn) descIn.value = '';

    const btn = document.getElementById('submit-report-btn');
    const btnText = document.getElementById('submit-btn-text');
    const btnIcon = document.getElementById('submit-btn-icon');
    const spinner = document.getElementById('submit-spinner');
    if (btn) btn.disabled = false;
    if (btnText) btnText.textContent = 'Submit Report';
    if (btnIcon) btnIcon.classList.remove('hidden');
    if (spinner) spinner.classList.add('hidden');

    document.getElementById('success-screen').classList.add('hidden');
    goToStep(1);
    showToast('New report docket initialized', 'refresh');
  }

  // Toast Notification Dispatcher
  function showToast(message, iconName = 'info') {
    const toast = document.getElementById('toast-notification');
    const text = document.getElementById('toast-text');
    const icon = document.getElementById('toast-icon');

    if (!toast || !text || !icon) return;

    text.textContent = message;
    icon.textContent = iconName;

    toast.classList.remove('translate-y-24', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3200);
  }
</script></main><footer class="w-full bg-surface-container-low pt-space-2xl pb-space-xl mt-space-3xl shadow-[0_-1px_12px_rgba(0,0,0,0.02)]"><div class="max-w-[1380px] mx-auto px-margin lg:px-margin-desktop"><div class="grid grid-cols-1 md:grid-cols-12 gap-gutter lg:gap-gutter-desktop pb-space-2xl"><div class="md:col-span-5 flex flex-col justify-between pr-space-md"><div class="space-y-space-sm"><div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-[20px]">account_balance</span><span class="font-headline-sm text-headline-sm uppercase tracking-wider text-primary">WARDWISE</span></div><p class="font-body-md text-body-md text-on-surface-variant max-w-sm">Open municipal telemetry and civic intelligence system engineered for metropolitan governance, participatory oversight, and public auditability.</p></div><div class="mt-space-lg flex items-center gap-space-sm"><span class="inline-flex items-center gap-1.5 px-space-md py-1 rounded-full bg-surface-container-highest text-on-surface font-label-sm text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>System Telemetry: Nominal</span><span class="font-label-sm text-label-sm text-on-surface-variant">v4.8.2-civic</span></div></div><div class="md:col-span-2 space-y-space-sm"><h4 class="font-label-md text-label-md uppercase tracking-wider text-primary">Civic Framework</h4><ul class="space-y-2"><li class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors"><a data-path="transparency" href="#">Civic Bylaws</a></li><li class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors"><a data-path="transparency" href="#">Public Record Index</a></li><li class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors"><a data-path="transparency" href="#">Open Data Charter</a></li><li class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-col